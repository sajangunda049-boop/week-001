import weka.core.Instances;
import weka.core.Attribute;
import weka.core.converters.ConverterUtils.DataSource;

public class WekaDatasetAnalysis {

    public static void main(String[] args) throws Exception {

        // Load the Iris dataset
        DataSource source = new DataSource("iris.arff");
        Instances data = source.getDataSet();

        // Display dataset information
        System.out.println("Dataset Name: " + data.relationName());
        System.out.println("Number of Records: " + data.numInstances());
        System.out.println("Number of Attributes: " + data.numAttributes());

        // Display attribute names and types
        System.out.println("\nAttribute Names and Types:");

        for (int i = 0; i < data.numAttributes(); i++) {
            Attribute attr = data.attribute(i);

            System.out.println(
                attr.name() + " : " + attr.typeToString()
            );
        }

        // Set the last attribute as the class attribute
        data.setClassIndex(data.numAttributes() - 1);

        System.out.println(
            "\nClass Attribute: " + data.classAttribute().name()
        );

        // Count instances belonging to each class
        Attribute classAttr = data.classAttribute();

        System.out.println("\nNumber of Records for Each Class:");

        if (classAttr.isNominal()) {
            for (int i = 0; i < classAttr.numValues(); i++) {
                int count = 0;

                for (int j = 0; j < data.numInstances(); j++) {
                    if (!data.instance(j).isMissing(data.classIndex())
                        && (int) data.instance(j).classValue() == i) {
                        count++;
                    }
                }

                System.out.println(
                    classAttr.value(i) + " : " + count
                );
            }
        }

        // Display dataset records
        System.out.println("\nDataset Contents:");
        System.out.println(data);
    }
}
